# =========================================
# SPOTTERS.COM - Environment Configuration
# =========================================
# Copy this file to server/.env and fill in real values.
# NEVER commit the real .env file to version control.

# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- Database (MySQL) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=spotters_db

# ---- Authentication ----
# Generate a strong random string for production, e.g. `openssl rand -hex 32`
# Server refuses to start if this is missing or shorter than 16 characters.
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=spotters_token

# ---- AI Service (Navigation AI) ----
# Leave AI_PROVIDER blank for demo mode (feedback built only from the stored case text).
# Real AI feedback with Google Gemini:  AI_PROVIDER=gemini  + your own key + a model ID.
# The key stays on the server. NEVER put it in client code or commit server/.env.
# Create a key in Google AI Studio (aistudio.google.com/apikey).
AI_PROVIDER=
AI_API_KEY=
# gemini-2.5-flash is the model requested for this project. Google's deprecations page says the 2.5
# models stay available only to projects that have already used them; if you get a 404, use a newer
# model such as gemini-3.5-flash-lite or gemini-3.8-flash. Verify IDs in AI Studio.
AI_MODEL=
# Optional: per-request timeout in ms (default 20000, minimum 1000)
# AI_TIMEOUT_MS=20000
